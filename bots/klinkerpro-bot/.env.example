# --- AI: YandexGPT (основной) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite

# --- AI: OpenAI (запасной) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- MAX — заявки менеджеру (включить позже) ---
# Пока оставьте MAX_NOTIFY_ENABLED=false — в MAX ничего не уходит.
MAX_NOTIFY_ENABLED=false
# https://dev.max.ru → токен бота
# npm run max:chat-id — узнать MAX_CHAT_ID после сообщения боту в чате заявок
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_USER_ID=

# PNG маскота над кнопкой виджета (desktop), например URL с Tilda CDN
# WIDGET_MASCOT_URL=

# --- Telegram (опционально, для чата в мессенджере; заявки → MAX) ---
TELEGRAM_BOT_TOKEN=
# TELEGRAM_MODE=polling

# --- Сервер (тот же VPS, что boat; другой порт) ---
PORT=3001
PUBLIC_URL=https://klinker.webtaxi2.ru
BOT_NAME=КлинкерПрофи

# --- Без контакта: уведомление в MAX после паузы (минуты) ---
NO_CONTACT_IDLE_MINUTES=10

# --- Алерт «ИИ упал» ---
AI_ALERT_COOLDOWN_MINUTES=30
# TZ=Europe/Moscow
