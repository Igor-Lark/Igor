# --- AI: YandexGPT (основной) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель: yandexgpt-lite | yandexgpt
YANDEX_MODEL=yandexgpt-lite

# --- AI: OpenAI (запасной, если Yandex не настроен) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Telegram (опционально: ИИ-чат в Telegram) ---
# Если не нужен — оставьте пустым. Заявки менеджеру идут в MAX.
TELEGRAM_BOT_TOKEN=

# --- MAX (мессенджер) — заявки от ИИ-бота + отзывы Avito ---
# Пишем в ГРУППОВОЙ чат, где уже стоит бот Тильды (заявки с сайта).
# 1) Создайте своего бота → MAX_BOT_TOKEN
# 2) Добавьте ЭТОГО бота в тот же чат, что и бот Тильды
# 3) npm run max:chat-id  → получите MAX_CHAT_ID
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# (опционально) личка вместо группы:
MAX_USER_ID=
# Объявление для мониторинга (по умолчанию — аренда яхты Олега)
AVITO_ITEM_URL=https://m.avito.ru/sochi/predlozheniya_uslug/arenda_yahty_s_kapitanom_7252469249
# 1 = писать в MAX даже если новых отзывов нет
AVITO_NOTIFY_ALWAYS=0

# --- Сервер ---
PORT=3000
# Публичный HTTPS-URL после деплоя (для webhook и embed.js)
PUBLIC_URL=https://bot.ваш-домен.ru

# Имя бота в виджете
BOT_NAME=Boat Sochi
