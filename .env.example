# --- AI: YandexGPT (основной) ---
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель: yandexgpt-lite | yandexgpt
YANDEX_MODEL=yandexgpt-lite

# --- AI: OpenAI (запасной, если Yandex не настроен) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Telegram — ИИ-чат + заявки менеджеру (эта ветка) ---
TELEGRAM_BOT_TOKEN=
# Chat ID менеджера для заявок (узнать у @userinfobot)
TELEGRAM_MANAGER_CHAT_ID=
# polling | webhook (пусто = webhook если PUBLIC_URL боевой)
# TELEGRAM_MODE=polling
# Если VPS не достучится до api.telegram.org (ETIMEDOUT) — HTTP/SOCKS прокси:
# TELEGRAM_PROXY=http://user:pass@host:port
# TELEGRAM_PROXY=socks5://user:pass@host:port

# --- MAX (опционально) — только отзывы Avito ---
# Заявки от ИИ в этой ветке идут в Telegram, не в MAX.
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_USER_ID=
AVITO_ITEM_URL=https://m.avito.ru/sochi/predlozheniya_uslug/arenda_yahty_s_kapitanom_7252469249
AVITO_NOTIFY_ALWAYS=0

# --- Сервер ---
PORT=3000
PUBLIC_URL=https://bot.ваш-домен.ru
BOT_NAME=Boat Sochi

# --- Напоминания о выходе (пока ВЫКЛЮЧЕНО) ---
# 1 = включить автонапоминания клиенту за N часов до начала
BOOKING_REMINDERS_ENABLED=0
BOOKING_REMINDER_HOURS=3
# На VPS лучше: TZ=Europe/Moscow
# TZ=Europe/Moscow

# --- Без контакта: уведомить менеджера после паузы в диалоге (минуты) ---
NO_CONTACT_IDLE_MINUTES=10
