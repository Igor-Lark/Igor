# Каталог базы, загрузок и журналов. Каталог создаётся при запуске.
BCF_DATA_DIR=./data

# Сколько задач выполнять одновременно.
BCF_MAX_CONCURRENT_TASKS=2

# Сколько внешних HTTP-вызовов (страницы, поиск, LLM) держать одновременно.
BCF_MAX_EXTERNAL_CALLS=3

# Тайм-ауты в миллисекундах.
BCF_FETCH_TIMEOUT_MS=15000
BCF_LLM_TIMEOUT_MS=60000

# Максимальный размер загружаемого креатива.
BCF_MAX_UPLOAD_BYTES=15728640

# Как часто исполнитель смотрит очередь, мс.
BCF_POLL_MS=1000

# 0 отключает стартовое наполнение пустой базы. Для обычной работы не задавайте.
# BCF_SEED=0

# OpenAI-совместимый API. Без ключа текстовые генерации не выполняются и не подменяются.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Отдельная модель со зрением. Если пусто, экспертные оценки креативов недоступны.
OPENAI_VISION_MODEL=

# Необязательный веб-поиск. Без ключа исследование идёт только по URL, которые указал пользователь.
TAVILY_API_KEY=
